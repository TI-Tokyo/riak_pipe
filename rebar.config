%% -*- mode: erlang -*-

{deps,
 [{riak_core, {git, "https://github.com/TI-Tokyo/riak_core.git", {branch, "riak_ts-develop-3.0"}}}
 ]
}.

{plugins,
 [{eqc_rebar, {git, "https://github.com/Quviq/eqc-rebar", {branch, "master"}}}
 ]
}.

{erl_opts,
 [warnings_as_errors,
  debug_info,
  {parse_transform, lager_transform}
 ]
}.

{edoc_opts, [{preprocess, true}]}.
{cover_enabled, true}.
